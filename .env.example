# blabber-bot configuration — copy to `.env` and edit.
#   cp .env.example .env

# Required: bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Register slash commands on one guild only (instant) while testing.
# Leave unset to publish commands globally.
#DISCORD_GUILD_ID=

# --- Age-restricted / private videos ---------------------------------------
# Netscape-format cookies.txt exported from a signed-in, age-verified browser
# session (see README). Plain Unix paths: relative to the working directory,
# absolute, or `~/...` are all fine.
#YTDLP_COOKIES=./cookies.txt
# In Docker, point this at the read-only source the compose mount provides; the
# entrypoint copies it to a writable jar in the data volume, because yt-dlp
# rewrites the jar on every extraction and would otherwise overwrite your export.
#YTDLP_COOKIES_SOURCE=/home/bot/cookies.source

# Stop playing and disconnect after the voice channel is empty for this many
# seconds. Default 300 (5 min). Set to 0 to stay connected indefinitely.
#EMPTY_CHANNEL_TIMEOUT=300
# Or let yt-dlp read a browser profile directly:
#YTDLP_COOKIES_FROM_BROWSER=firefox

# --- Playback tuning --------------------------------------------------------
#YTDLP_PATH=yt-dlp
#YTDLP_EXTRA_ARGS=
#MAX_PLAYLIST=25
#DEFAULT_VOLUME=100
#AUTOPLAY=true

# --- Storage ----------------------------------------------------------------
#Docker sets DATABASE_PATH=/home/bot/data/blabber-bot.db automatically.
#DATABASE_PATH=blabber-bot.db

# --- Logging ----------------------------------------------------------------
#RUST_LOG=info
